DJANGO_SECRET_KEY=replace-with-a-random-local-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=rapid_market
DB_USER=postgres
DB_PASSWORD=replace-with-your-local-postgres-password
DB_HOST=127.0.0.1
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://127.0.0.1:8000/api

# Recuperación de contraseña por correo. Si EMAIL_HOST queda vacío, el enlace
# se escribe en la terminal de Django para desarrollo local.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Rapid Market <no-reply@rapidmarket.local>
FRONTEND_URL=http://127.0.0.1:5173
